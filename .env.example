# ──────────────────────────────────────────────────────────────────────
# DiscountDora — runtime configuration
# ──────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in for your environment. Every variable is
# optional — defaults shown are what the app falls back to. The compose
# file at repo root reads these.
#
# Env vars take precedence over the JSON appsettings file at
# `config/dapi.appsettings.json`, so you can override anything here
# without editing files inside the image.
# ──────────────────────────────────────────────────────────────────────


# ── Runtime profile (D3) ─────────────────────────────────────────────
# Selects the profile that drives sensible defaults for log level,
# debug mode, CORS, and seed behaviour. Accepted values:
#   development | production | test
# Aliases accepted: dev, prod, local, testing, ci.
#
# Production also REQUIRES the following vars to be set (the app
# refuses to boot otherwise, printing a friendly list of what's
# missing): DORA_SECRET_KEY, DORA_CORS_ORIGINS, ADMIN_BOOTSTRAP_EMAIL.
DORA_ENV=development


# ── Container basics ─────────────────────────────────────────────────
# Timezone used for log timestamps + scheduled tasks (audit retention
# sweep). Australia/Sydney by default.
TZ=Australia/Sydney


# ── Secrets / auth ───────────────────────────────────────────────────
# Signs the Flask session cookie. MUST be set to a long random string
# in production. If unset, the app writes a random key to
# `data/.secret_key` on first boot so sessions survive restarts — fine
# for local dev, not for prod.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
DORA_SECRET_KEY=

# Set to true behind HTTPS so the browser only sends the session
# cookie over TLS. Leave false for plain-HTTP local dev.
DORA_SECURE_COOKIES=false

# Set to true to wipe and re-seed the database on startup. Only
# honoured in development (production refuses regardless — the
# DORA_ENV gate prevents accidental data loss).
DORA_ALLOW_DESTRUCTIVE=false

# Comma-separated list of allowed CORS origins. REQUIRED in
# production. Dev defaults cover the web SPA on localhost AND the
# Capacitor mobile client (capacitor://localhost on iOS,
# http://localhost on Android) so a mobile build pointed at a dev
# backend Just Works. Production must enumerate every host the SPA
# and mobile clients reach you from, e.g.:
#   DORA_CORS_ORIGINS=https://dora.example.com,capacitor://localhost
DORA_CORS_ORIGINS=


# ── Storage paths ────────────────────────────────────────────────────
# All paths can be absolute or relative-to-cwd. Inside the container
# the defaults below map to named volumes (see compose.yml).
DORA_DATA_DIR=/app/data
DORA_CACHE_DIR=/app/cache
DORA_LOG_DIR=/app/logs

# Pin the sqlite db location explicitly. When unset, the app derives
# it from DORA_DATA_DIR (`<DATA_DIR>/dora.data.db`).
DORA_DB_PATH=


# ── Dora API tuning ──────────────────────────────────────────────────
DORA_API_PORT=5170
# DEBUG | INFO | WARNING | ERROR | CRITICAL | FATAL
DORA_LOG_LEVEL=ERROR
# Set DORA_DEBUG=true to enable Flask's debug mode. Off in prod.
DORA_DEBUG=


# ── Transactional email (auth flows) ─────────────────────────────────
# Used by dora_api/infrastructure/email_sender.py for verify-email +
# password-reset + change-email confirmations. When DORA_SMTP_USER is
# unset the sender runs in DRY-RUN mode (logs the email body instead
# of dispatching) — fine for dev installs without SMTP.
DORA_SMTP_HOST=
DORA_SMTP_PORT=587
DORA_SMTP_USER=
DORA_SMTP_PASSWORD=
DORA_SMTP_FROM=


# ── First-run admin ──────────────────────────────────────────────────
# On a fresh database, the first user to register becomes admin. If
# this var is set, the boot routine instead creates an admin account
# with this email (random password — reset via the forgot-password
# flow). Useful for headless deployments where there's no human at
# the keyboard for the first registration.
ADMIN_BOOTSTRAP_EMAIL=


# ── AI assistant ─────────────────────────────────────────────────────
# Opt-in and configured *in-app* (Settings → System → AI assistant,
# admin only) — not via env. Run your own LLM (e.g. Ollama), then
# point Dora at it from the settings page. Nothing is enabled or
# downloaded by default.
