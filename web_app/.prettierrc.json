{
    "$schema": "https://json.schemastore.org/prettierrc",
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "htmlWhitespaceSensitivity": "ignore",
    "jsxSingleQuote": true,
    "printWidth": 120,
    "semi": true,
    "singleAttributePerLine": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "none",
    "vueIndentScriptAndStyle": true,
    "attributeGroups": [
        "$CODE_GUIDE"
    ],
    "attributeSort": "ASC",
    "attributeIgnoreCase": false
}
