__pycache__
!.vscode/launch.json
!.vscode/tasks.json
# aldi_products_by_category.json is bundled as a seed; on first boot
# it's copied into <CACHE_DIR>/ where operators can edit a persistent
# copy without touching the bundled file. Keep the seed in git.
!aldi_products_by_category.json
.DS_Store
.env
.env.local*
.idea
# D2: legacy paths retired — runtime state now lives under data/,
# cache/, and logs/ (configurable via DORA_DATA_DIR / DORA_CACHE_DIR /
# DORA_LOG_DIR). Keep the directory ignores so a `docker compose run`
# that bind-mounts ./data into the container doesn't pollute git.
# Root-anchored so unrelated `data/` subdirs (e.g.
# `dora_api/features/data/`) aren't silently ignored — that bug bit
# P8-02 when adding a new file under the features tree.
/data/
/cache/
/logs/
.quasar
.thumbs.db
.venv
.image_cache
.vscode
.vscode/*
*.cjs
*.local
*.log
*.njsproj
*.ntvs*
*.prettierrc
*.sln
*.suo
*.sw?
