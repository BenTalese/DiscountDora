# Base URL for the Dora API. The frontend appends /api routes to this.
# Leave unset to use the dev fallback: http://<window.location.hostname>:5170/api
VITE_API_BASE_URL=http://localhost:5170/api

# Base URL for the Merchant API (product scraping, deal feeds, merchant config).
# Runs as a separate Flask app on port 5172. Leave unset to use the dev fallback:
# http://<window.location.hostname>:5172/api
VITE_MERCHANT_API_BASE_URL=http://localhost:5172/api
