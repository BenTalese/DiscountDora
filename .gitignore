**/.buildozer
**/*.db
**/appsettings.json
**/bin
*appsettings.json
/cypress/screenshots/
/cypress/videos/
/dist
/quasar.config.*.temporary.compiled*
/src-capacitor/node_modules
/src-capacitor/www
/src-cordova/node_modules
/src-cordova/platforms
/src-cordova/plugins
/src-cordova/www
coverage
dist
dist-ssr
# Desktop bundle artefacts (PyInstaller writes to dist/ + build/ at
# the repo root; Phase 4 produces *.AppImage in dist/ and caches
# appimagetool under packaging/.cache/).
build/
*.AppImage
packaging/.cache/
# Piper binary fetched at build time by packaging/fetch_piper.py — a build
# artefact, never committed (it's bundled into the PyInstaller output instead).
packaging/piper/
# Piper voice models fetched at build time by packaging/fetch_default_voice.py
# — ~60 MB each, never committed. Bundled into Docker / desktop builds so
# Dora's neural voice works out of the box on first run.
packaging/voices/
web_app_old/.vscode/*
web_app/.vscode/*
lerna-debug.log*
logs
node_modules
npm-debug.log*
pnpm-debug.log*
venv
yarn-debug.log*
yarn-error.log*
.coverage

