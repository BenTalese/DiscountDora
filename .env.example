# Dora API runtime configuration.
# Copy to `.env` and fill in for your environment. Values shown are dev defaults.

# Signs the Flask session cookie. MUST be set to a long random string in
# production. If unset, the app writes a random key to `data/.secret_key` on
# first boot so sessions survive restarts — fine for local dev, not for prod.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
DORA_SECRET_KEY=

# Set to true behind HTTPS so the browser only sends the session cookie over
# TLS. Leave false for plain-HTTP local dev.
DORA_SECURE_COOKIES=false

# Set to true to wipe and re-seed the database on startup. Only honoured when
# the app is in debug mode or running under tests. Leave unset in production.
DORA_ALLOW_DESTRUCTIVE=false

# The AI assistant is opt-in and configured in-app (Settings > System, admin
# only) — not via env. Run your own LLM (e.g. Ollama), then point Dora at it
# there. Nothing is enabled or downloaded by default.
