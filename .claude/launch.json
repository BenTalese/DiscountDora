{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "dora-backend",
            "runtimeExecutable": "python",
            "runtimeArgs": ["-m", "dora_api.startup"],
            "port": 5170
        },
        {
            "name": "dora-backend-linux",
            "runtimeExecutable": ".venv/bin/python",
            "runtimeArgs": ["-m", "dora_api.startup"],
            "port": 5170
        },
        {
            "name": "dora-verify-backend",
            "runtimeExecutable": ".venv\\Scripts\\python.exe",
            "runtimeArgs": ["-m", "dora_api.startup"],
            "port": 5170,
            "env": {
                "DORA_DEBUG": "true",
                "DORA_ALLOW_DESTRUCTIVE": "true",
                "DORA_SEED_BULK_ITEMS": "40",
